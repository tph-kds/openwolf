{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "paths": {
      "@openwolf/core/*": ["./core/*"],
      "@openwolf/adapters/*": ["./adapters/*"],
      "@openwolf/interfaces": ["./src/interfaces/index.ts"],
      "@openwolf/interfaces/*": ["./src/interfaces/*"]
    }
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "core/**/*.ts",
    "adapters/**/*.ts",
    "storage/**/*.ts",
    "providers/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/dashboard/app"]
}
